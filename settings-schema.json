{
  "location": {
    "type": "entry",
    "default": "52.9667,11.15",
    "description": "GPS: Breitengrad,Längengrad (z.B. 52.52,13.405)"
  },
  "location-name": {
    "type": "entry",
    "default": "Lüchow",
    "description": "Display name (e.g. Berlin)"
  },
  "temperature-unit": {
    "type": "combobox",
    "default": "celsius",
    "options": {
      "celsius": "°C (Celsius)",
      "fahrenheit": "°F (Fahrenheit)"
    },
    "description": "Temperature unit"
  },
  "wind-unit": {
    "type": "combobox",
    "default": "kmh",
    "options": {
      "kmh": "km/h",
      "ms": "m/s",
      "mph": "mph"
    },
    "description": "Wind speed unit"
  },
  "update-interval": {
    "type": "spinbutton",
    "default": 30,
    "min": 5,
    "max": 60,
    "step": 5,
    "units": "minutes",
    "description": "Auto-update interval"
  },
  "show-humidity": {
    "type": "checkbox",
    "default": true,
    "description": "Show humidity"
  },
  "show-pressure": {
    "type": "checkbox",
    "default": true,
    "description": "Show atmospheric pressure"
  },
  "show-uv-index": {
    "type": "checkbox",
    "default": true,
    "description": "Show UV index"
  },
  "show-precipitation": {
    "type": "checkbox",
    "default": true,
    "description": "Show precipitation probability"
  },
  "show-sunrise-sunset": {
    "type": "checkbox",
    "default": true,
    "description": "Show sunrise and sunset times"
  },
  "compact-mode": {
    "type": "checkbox",
    "default": false,
    "description": "Compact layout (less data)"
  },
  "text-color": {
    "type": "colorchooser",
    "default": "#ffffff",
    "description": "Text color"
  },
  "bg-color": {
    "type": "colorchooser",
    "default": "#1a1a1a",
    "description": "Background color"
  },
  "opacity": {
    "type": "spinbutton",
    "default": 100,
    "min": 0,
    "max": 100,
    "step": 10,
    "units": "%",
    "description": "Background opacity"
  }
}
